#!/usr/bin/env bash
# Launch oh-my-cli against ollama.com using OLLAMA_API_KEY.
set -euo pipefail
source "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")/lib.sh"
_require_key

_resolve_model oh-my-cli "$@"

export OPENAI_BASE_URL="$OLLAMA_HOST_URL/v1"
export OPENAI_API_KEY="$OLLAMA_API_KEY"
export OPENAI_MODEL="$MODEL"

exec oh-my-cli "${REST[@]+"${REST[@]}"}"
