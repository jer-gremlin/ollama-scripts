#!/usr/bin/env bash
# Launch Claude Code against ollama.com using OLLAMA_API_KEY.
set -euo pipefail
source "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")/lib.sh"
_require_key

_resolve_model claude "$@"

export ANTHROPIC_BASE_URL="$OLLAMA_HOST_URL"
export ANTHROPIC_AUTH_TOKEN="$OLLAMA_API_KEY"   # ollama needs Bearer, not x-api-key
unset ANTHROPIC_API_KEY 2>/dev/null || true
export ANTHROPIC_MODEL="$MODEL"
export ANTHROPIC_SMALL_FAST_MODEL="${OLLAMA_SMALL_MODEL:-$MODEL}"

exec claude "${REST[@]+"${REST[@]}"}"
